<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <PackageReference Include="JsonSchema.Net" Version="9.4.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The normative schema is linked in from docs/ rather than copied, so the document the code
      validates against and the document the contract publishes cannot drift apart (ADR-004).
      LogicalName is fixed because TelemetrySchema resolves the resource by that exact string.
    -->
    <EmbeddedResource Include="..\..\docs\schemas\telemetry-v1.schema.json"
      Link="Schemas\telemetry-v1.schema.json"
      LogicalName="IIoT.Core.Schemas.telemetry-v1.schema.json" />
  </ItemGroup>

</Project>
