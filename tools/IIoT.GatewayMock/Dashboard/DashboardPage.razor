@*
    The dashboard: one static, server-rendered page. No interactivity and no script.

    Every value shown came from a request body or a token and is untrusted. Razor HTML-encodes
    every @ expression, in text and in attribute values alike, so a device ID such as
    <script>…</script> is shown as text, never run. The only way to bypass that is MarkupString,
    which this page never uses. The response's Content-Security-Policy forbids script as well, in
    case an encoding gap is ever introduced.
*@
@using System.Globalization
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta http-equiv="refresh" content="@RefreshSeconds" />
    <title>Gateway mock · received readings</title>
    <style>
        :root { color-scheme: light dark; font-family: system-ui, sans-serif; line-height: 1.4; }
        body { margin: 0 auto; padding: 1rem; max-width: 80rem; }
        header p { margin: 0.25rem 0; }
        h1 { font-size: 1.4rem; margin: 0 0 0.5rem; }
        h2 { font-size: 1.1rem; margin: 1.5rem 0 0.5rem; }
        .muted { opacity: 0.7; }
        .scroll { overflow-x: auto; }
        table { border-collapse: collapse; width: 100%; font-size: 0.9rem; }
        th, td { text-align: left; vertical-align: top; padding: 0.3rem 0.6rem; border-bottom: 1px solid color-mix(in srgb, currentColor 20%, transparent); }
        th { white-space: nowrap; }
        td.number { text-align: right; font-variant-numeric: tabular-nums; }
        code { font-size: 0.85rem; word-break: break-all; }
        ul.readings { margin: 0; padding-left: 1rem; }
    </style>
</head>
<body>
    <header>
        <h1>Gateway mock · received readings</h1>
        <p>Signed in as <strong>@(SignedInAs ?? "(unnamed user)")</strong> · <a href="@SignOutPath">Sign out</a></p>
        <p class="muted">
            @Snapshot.BatchCount batch(es) received since the mock started.
            Shown at @Utc(Snapshot.TakenAt); refreshes every @RefreshSeconds seconds.
            Held in memory: a restart empties it.
        </p>
    </header>

    <main>
        <section>
            <h2>Latest reading per device</h2>
            @if (Snapshot.LatestPerDevice.Count == 0)
            {
                <p class="muted">No readings received yet.</p>
            }
            else
            {
                <div class="scroll">
                    <table>
                        <thead>
                            <tr>
                                <th>Device</th>
                                <th>Value</th>
                                <th>Quality</th>
                                <th>Measured at (device clock)</th>
                                <th>Received at (platform)</th>
                                <th>Message ID</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var latest in Snapshot.LatestPerDevice)
                            {
                                <tr>
                                    <td><code>@latest.DeviceId</code></td>
                                    <td class="number">@Show(latest.Reading.Value) @latest.Reading.Unit</td>
                                    <td>@Show(latest.Reading.Quality)</td>
                                    <td>@Show(latest.Reading.At)</td>
                                    <td>@Show(latest.Batch.ReceivedAt)</td>
                                    <td><code>@latest.Batch.MessageId</code></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>

        <section>
            <h2>Received batches</h2>
            @if (Snapshot.NewestBatches.Count == 0)
            {
                <p class="muted">No batches received yet.</p>
            }
            else
            {
                <p class="muted">
                    Newest first@(Snapshot.BatchCount > Snapshot.NewestBatches.Count ? $"; the newest {Snapshot.NewestBatches.Count} of {Snapshot.BatchCount}" : "").
                    A replay of a stored batch is acknowledged but not stored again, so it does not appear twice.
                </p>
                <div class="scroll">
                    <table>
                        <thead>
                            <tr>
                                <th>Stored at (mock)</th>
                                <th>Received at (platform)</th>
                                <th>Device</th>
                                <th>Message ID / Idempotency-Key</th>
                                <th>Caller</th>
                                <th>Firmware</th>
                                <th>Readings</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var batch in Snapshot.NewestBatches)
                            {
                                <tr>
                                    <td>@Utc(batch.StoredAt)</td>
                                    <td>@Show(batch.ReceivedAt)</td>
                                    <td><code>@batch.DeviceId</code></td>
                                    <td><code>@batch.MessageId</code></td>
                                    <td><code>@Show(batch.Caller)</code></td>
                                    <td>@Show(batch.Firmware)</td>
                                    <td>
                                        <ul class="readings">
                                            @foreach (var reading in batch.Readings)
                                            {
                                                <li>@Show(reading.Kind) @Show(reading.Value) @reading.Unit, @Show(reading.Quality), at @Show(reading.At)</li>
                                            }
                                        </ul>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>
    </main>
</body>
</html>

@code {
    [Parameter, EditorRequired]
    public DashboardSnapshot Snapshot { get; set; } = default!;

    /// <summary>The signed-in user's name, as the provider sent it.</summary>
    [Parameter]
    public string? SignedInAs { get; set; }

    [Parameter, EditorRequired]
    public int RefreshSeconds { get; set; }

    [Parameter, EditorRequired]
    public string SignOutPath { get; set; } = default!;

    private static string Show(string? value) => string.IsNullOrEmpty(value) ? "—" : value;

    private static string Utc(DateTimeOffset value) =>
        value.UtcDateTime.ToString("yyyy-MM-dd HH:mm:ss 'UTC'", CultureInfo.InvariantCulture);
}
