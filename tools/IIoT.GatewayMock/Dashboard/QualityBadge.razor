@*
    The device's own assessment of a reading, as a coloured label. The class comes from a fixed
    set; the text is the value as sent, HTML-encoded like everything else.
*@
<span class="badge @Css">@DashboardFormat.Show(Quality)</span>

@code {
    [Parameter]
    public string? Quality { get; set; }

    private string Css => Quality switch
    {
        "ok" => "ok",
        "uncertain" => "uncertain",
        "bad" => "bad",
        _ => "unknown"
    };
}
