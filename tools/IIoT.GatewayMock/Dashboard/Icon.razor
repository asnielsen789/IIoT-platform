@*
    A line icon, drawn inline: no request for an image, which the Content-Security-Policy would
    refuse. Decorative, so hidden from assistive technology; the text next to it says what it means.
*@
<svg class="icon" width="@Size" height="@Size" viewBox="0 0 24 24" fill="none" stroke="currentColor"
     stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
    @switch (Name)
    {
        case "tank":
            <ellipse cx="12" cy="5" rx="7" ry="2.5" />
            <path d="M5 5v14c0 1.4 3.1 2.5 7 2.5s7-1.1 7-2.5V5" />
            <path d="M5 12.5c0 1.4 3.1 2.5 7 2.5s7-1.1 7-2.5" />
            break;
        case "message":
            <rect x="3" y="5" width="18" height="14" rx="2" />
            <path d="m3.5 7 8.5 6 8.5-6" />
            break;
        case "readings":
            <path d="M3 12h4l3-8 4 16 3-8h4" />
            break;
        case "clock":
            <circle cx="12" cy="12" r="9" />
            <path d="M12 7v5l3 2" />
            break;
        case "chip":
            <rect x="7" y="7" width="10" height="10" rx="1.5" />
            <path d="M10 3v4M14 3v4M10 17v4M14 17v4M3 10h4M3 14h4M17 10h4M17 14h4" />
            break;
        case "chart":
            <path d="M3 3v18h18" />
            <path d="m7 15 4-4 3 3 5-6" />
            break;
        case "code":
            <path d="m8 7-5 5 5 5M16 7l5 5-5 5" />
            break;
        case "user":
            <circle cx="12" cy="8" r="4" />
            <path d="M4 21c0-4 3.6-7 8-7s8 3 8 7" />
            break;
        case "chevron":
            <path d="m9 6 6 6-6 6" />
            break;
        case "back":
            <path d="m15 6-6 6 6 6" />
            break;
        case "close":
            <path d="M6 6l12 12M18 6 6 18" />
            break;
    }
</svg>

@code {
    /// <summary>Which icon: one of the names in the switch above. An unknown name draws nothing.</summary>
    [Parameter, EditorRequired]
    public string Name { get; set; } = default!;

    [Parameter]
    public int Size { get; set; } = 20;
}
