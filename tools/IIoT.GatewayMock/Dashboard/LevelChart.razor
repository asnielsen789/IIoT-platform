@*
    The level trend, laid out by LevelTrend on the server. The SVG is the plot alone, stretched to
    the width (preserveAspectRatio="none"); its labels are HTML beside it, so they read the same on
    a phone and a wide screen. Lines keep their width when stretched (non-scaling-stroke), and each
    reading is a zero-length stroke with round caps: a dot that stays round however the plot is
    stretched, where a circle would become an ellipse.

    Each dot carries a <title>, which browsers show as a tooltip, with the reading's value, time
    and quality.
*@
@if (Trend.Points.Count == 0)
{
    <p class="empty">No reading with a readable time and value yet.</p>
}
else
{
    <div class="chart">
        <div class="plot">
            <div class="yaxis" aria-hidden="true">
                @foreach (var tick in Trend.ValueTicks)
                {
                    <span style="top: @LevelTrend.Percent(tick.Y)">@tick.Label</span>
                }
            </div>
            <svg viewBox="0 0 @LevelTrend.Number(LevelTrend.Width) @LevelTrend.Number(LevelTrend.Height)"
                 preserveAspectRatio="none" role="img" aria-label="@AriaLabel">
                @foreach (var tick in Trend.ValueTicks)
                {
                    <line class="grid" x1="0" x2="@LevelTrend.Number(LevelTrend.Width)"
                          y1="@LevelTrend.Number(tick.Y)" y2="@LevelTrend.Number(tick.Y)" />
                }

                @if (Trend.Points.Count > 1)
                {
                    <polygon class="area" points="@Trend.Area" />
                    <polyline class="line" points="@Trend.Line" />
                }

                @foreach (var point in Trend.Points)
                {
                    <path class="halo" d="@Dot(point)" />
                    <path class="dot @Quality(point.Reading.Quality)" d="@Dot(point)">
                        <title>@DashboardFormat.Show(point.Reading.Value) @point.Reading.Unit at @DashboardFormat.Instant(point.Reading.At), @DashboardFormat.Show(point.Reading.Quality)</title>
                    </path>
                }
            </svg>
        </div>
        <div class="xaxis" aria-hidden="true">
            <span>@DashboardFormat.Axis(Trend.From!.Value)</span>
            @if (Trend.To != Trend.From)
            {
                <span>@DashboardFormat.Axis(Trend.To!.Value)</span>
            }
        </div>
    </div>
    <div class="legend">
        <span><i class="ok"></i>ok</span>
        <span><i class="uncertain"></i>uncertain</span>
        <span><i class="bad"></i>bad</span>
        <span>@Trend.Points.Count reading(s)@(Trend.Unit is null ? "" : $", in {Trend.Unit}"), by measurement time</span>
    </div>
}

@code {
    [Parameter, EditorRequired]
    public LevelTrend Trend { get; set; } = default!;

    private string AriaLabel =>
        $"Level over time: {Trend.Points.Count} reading(s) from {DashboardFormat.Utc(Trend.From!.Value)} to {DashboardFormat.Utc(Trend.To!.Value)}.";

    /// <summary>A zero-length path at the point; its round caps draw the dot.</summary>
    private static string Dot(TrendPoint point) => $"M{LevelTrend.Number(point.X)},{LevelTrend.Number(point.Y)}h0.01";

    private static string Quality(string? quality) => quality is "ok" or "uncertain" or "bad" ? quality : "unknown";
}
