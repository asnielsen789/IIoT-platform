<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <RootNamespace>IIoT.GatewayMock</RootNamespace>
    <AssemblyName>IIoT.GatewayMock</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="JsonSchema.Net" Version="9.5.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Lets the integration tests exercise the configuration validator directly. Asserting its
      reasons through a started host is racy; see GatewayMockStartupTests.
    -->
    <InternalsVisibleTo Include="IIoT.Integration.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The mock validates against the published contract, linked in from docs/ rather than copied,
      so the document it enforces and the document the contract publishes are the same bytes.

      It deliberately does not reference IIoT.Core. If it judged requests with the platform's own
      types, a bug in those types would be invisible: the forwarder and the mock would agree with
      each other while both disagreed with the published schema. The schema is the single arbiter,
      exactly as the device fixtures are for the MQTT test client.
    -->
    <EmbeddedResource Include="..\..\docs\schemas\gateway\readings-v1.schema.json"
      Link="Schemas\readings-v1.schema.json"
      LogicalName="IIoT.GatewayMock.Schemas.readings-v1.schema.json" />
  </ItemGroup>

</Project>
